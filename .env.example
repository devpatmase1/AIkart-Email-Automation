# Copy this file to .env and fill in your own values.
# Run the app with: python deploy_api.py  (serves the dashboard on http://localhost:9000)

# --- LLM providers (at least one required; Groq is tried first, then OpenAI, then Gemini) ---
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
# GEMINI_API_KEY also works as an alias for GOOGLE_API_KEY

# --- Default sender shown in the dashboard (Gmail address + App Password) ---
MY_EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_gmail_app_password

# --- Optional HTTPS email APIs (bypass SMTP port blocking on Render/Railway) ---
RESEND_API_KEY=
BREVO_API_KEY=

# --- Optional: AWS SES SMTP (only used automatically for @aikart.co senders) ---
SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
